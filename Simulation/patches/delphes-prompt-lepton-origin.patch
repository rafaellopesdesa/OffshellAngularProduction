+
+Bool_t LeptonDressing::HasBosonAncestor(const Candidate *candidate) const
+{
+  vector<Int_t> pending;
+  set<Int_t> visited;
+  const Int_t leptonPID = TMath::Abs(candidate->PID);
+  AddMothers(candidate, pending);
+
+  while(!pending.empty())
+  {
+    const Int_t index = pending.back();
+    pending.pop_back();
+    if(index < 0 || index >= fParticleInputArray->GetEntriesFast()) continue;
+    if(!visited.insert(index).second) continue;
+
+    const Candidate *ancestor = static_cast<const Candidate *>(fParticleInputArray->At(index));
+    if(!ancestor) continue;
+    const Int_t absolutePID = TMath::Abs(ancestor->PID);
+    // VPolarization represents longitudinal and transverse Z bosons with
+    // PDG IDs 230 and 231. Keep the ordinary W/Z/gamma* behavior and also
+    // recognize these explicit polarized states if they survive showering.
+    if(absolutePID == 23 || absolutePID == 24 ||
+       absolutePID == 230 || absolutePID == 231) return true;
+    if(absolutePID == 22 && ancestor->Momentum.M() > fVirtualPhotonMinMass) return true;
+
+    // Follow status copies of the same lepton and, when explicitly enabled,
+    // tau-decay chains.  Low-mass photons are not followed, which excludes
+    // conversion electrons while retaining hard gamma* -> ll decays.
+    if(absolutePID == leptonPID || (fAllowTauDecayCandidate && absolutePID == 15))
+    {
+      AddMothers(ancestor, pending);
+    }
+  }
+  return false;
+}
+
+//------------------------------------------------------------------------------
+
+Bool_t LeptonDressing::HasDirectHardProcessAncestor(const Candidate *candidate) const
+{
+  vector<const Candidate *> pending;
+  set<const Candidate *> visited;
+  const Int_t leptonPID = candidate->PID;
+  pending.push_back(candidate);
+
+  while(!pending.empty())
+  {
+    const Candidate *lepton = pending.back();
+    pending.pop_back();
+    if(!lepton || !visited.insert(lepton).second) continue;
+    if(lepton->PID != leptonPID) continue;
+
+    vector<Int_t> mothers;
+    AddMothers(lepton, mothers);
+    if((lepton->Status == 1 || lepton->Status == 23) &&
+       mothers.size() == 2 && mothers[0] != mothers[1])
+    {
+      Bool_t directFromHardGluons = true;
+      for(vector<Int_t>::const_iterator it = mothers.begin();
+          it != mothers.end(); ++it)
+      {
+        const Candidate *mother = static_cast<const Candidate *>(
+          fParticleInputArray->At(*it));
+        if(!mother || mother->PID != 21 || mother->Status != 21)
+        {
+          directFromHardGluons = false;
+          break;
+        }
+      }
+      if(directFromHardGluons) return true;
+    }
+
+    // Pythia retains same-PDG copies when a hard outgoing lepton radiates.
+    // Follow only those copies. Never traverse a tau or photon: their
+    // decay/conversion leptons cannot use this VPolar-specific fallback.
+    for(vector<Int_t>::const_iterator it = mothers.begin();
+        it != mothers.end(); ++it)
+    {
+      const Candidate *mother = static_cast<const Candidate *>(
+        fParticleInputArray->At(*it));
+      if(mother && mother->PID == leptonPID)
+      {
+        pending.push_back(mother);
+      }
+    }
+  }
+  return false;
+}
+
+//------------------------------------------------------------------------------
+
+Bool_t LeptonDressing::IsCandidateEligible(const Candidate *candidate) const
+{
+  if(fRequireNoHadronAncestorCandidate && HasHadronAncestor(candidate)) return false;
+  if(fRequireBosonAncestorCandidate && !HasBosonAncestor(candidate)) return false;
+  if(fRequireDirectHardProcessCandidate &&
+     !HasDirectHardProcessAncestor(candidate)) return false;
+  return true;
+}
